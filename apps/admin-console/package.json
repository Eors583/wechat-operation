{
  "name": "@wechat-ai/admin-console",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.0",
    "pnpm": ">=11"
  },
  "scripts": {
    "api:generate": "openapi-typescript ../../contracts/generated/platform.openapi.json -o src/api/generated/schema.d.ts --immutable --alphabetize",
    "api:check": "openapi-typescript ../../contracts/generated/platform.openapi.json -o src/api/generated/schema.d.ts --immutable --alphabetize --check",
    "dev": "vite --host 0.0.0.0",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "lint": "eslint . --max-warnings=0 && stylelint \"src/**/*.{vue,scss}\"",
    "format": "prettier --write \"src/**/*.{ts,vue,scss,json,md}\" \"tests/**/*.{ts,vue,scss,json,md}\" \"*.{js,ts,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,vue,scss,json,md}\" \"tests/**/*.{ts,vue,scss,json,md}\" \"*.{js,ts,json,md}\"",
    "typecheck": "vue-tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --config playwright.integration.config.ts",
    "test:e2e:integration": "playwright test --config playwright.integration.config.ts"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "element-plus": "^2.14.5",
    "openapi-fetch": "^0.15.0",
    "pinia": "^4.0.3",
    "vue": "^3.5.42",
    "vue-router": "^5.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.4.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.5.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "openapi-typescript": "^7.13.0",
    "postcss-html": "^1.8.0",
    "prettier": "^3.9.6",
    "sass": "^1.103.1",
    "stylelint": "^16.14.1",
    "stylelint-config-standard-scss": "^14.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.11"
  }
}
