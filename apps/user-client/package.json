{
  "name": "wechat-ai-user-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "微信公众号 AI 运营助手用户端",
  "author": "微信公众号 AI 运营助手项目组",
  "scripts": {
    "dev": "quasar dev",
    "build": "quasar build",
    "build:pwa": "quasar build -m pwa",
    "build:electron": "quasar build -m electron",
    "build:capacitor:android": "quasar build -m capacitor -T android",
    "prepare:ios-config": "node scripts/prepare-ios-config.mjs",
    "sync:ios": "pnpm --dir src-capacitor exec cap sync ios && node scripts/fix-capacitor-swift-package.mjs",
    "build:capacitor:ios": "pnpm prepare:ios-config && pnpm sync:ios && quasar build -m capacitor -T ios",
    "api:generate": "openapi-typescript ../../contracts/generated/platform.openapi.json -o src/api/generated/schema.d.ts --immutable --alphabetize",
    "api:check": "openapi-typescript ../../contracts/generated/platform.openapi.json -o src/api/generated/schema.d.ts --immutable --alphabetize --check",
    "prepare": "quasar prepare",
    "lint": "eslint . --max-warnings=0 && stylelint \"src/**/*.{vue,scss}\"",
    "format": "prettier --write \"src/**/*.{ts,vue,scss,json,md}\" \"tests/**/*.{ts,vue,scss,json,md}\" \"*.{js,ts,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,vue,scss,json,md}\" \"tests/**/*.{ts,vue,scss,json,md}\" \"*.{js,ts,json,md}\"",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:integration": "playwright test --config playwright.integration.config.ts",
    "verify": "pnpm api:check && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@capacitor/app": "8.1.1",
    "@capacitor/browser": "8.0.4",
    "@capacitor/core": "^8.0.0",
    "@quasar/extras": "^1.16.17",
    "@tanstack/vue-query": "^5.66.11",
    "@tiptap/extension-image": "^2.11.5",
    "@tiptap/extension-link": "^2.11.5",
    "@tiptap/extension-paragraph": "^2.11.5",
    "@tiptap/extension-table": "2.27.2",
    "@tiptap/extension-table-cell": "2.27.2",
    "@tiptap/extension-table-header": "2.27.2",
    "@tiptap/extension-table-row": "2.27.2",
    "@tiptap/starter-kit": "^2.11.5",
    "@tiptap/vue-3": "^2.11.5",
    "openapi-fetch": "^0.17.0",
    "pinia": "^3.0.1",
    "qrcode": "^1.5.4",
    "quasar": "^2.28.0",
    "vue": "^3.5.13",
    "vue-router": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@playwright/test": "^1.50.1",
    "@quasar/app-vite": "^3.0.0",
    "@types/node": "^22.13.1",
    "@types/qrcode": "^1.5.5",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.20.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.0.0",
    "globals": "^16.0.0",
    "jsdom": "^26.0.0",
    "openapi-typescript": "7.13.0",
    "postcss-html": "^1.8.0",
    "prettier": "^3.9.6",
    "sass-embedded": "^1.83.4",
    "stylelint": "^16.14.1",
    "stylelint-config-standard-scss": "^14.0.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.24.0",
    "vite": "^8.0.0",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.0.5"
  },
  "engines": {
    "node": ">=22.22",
    "pnpm": ">=11"
  }
}
