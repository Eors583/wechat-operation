VITE_API_BASE_URL=/api/v1
# Native production builds must use absolute HTTPS origins; never device localhost.
VITE_API_BASE_URL_ELECTRON=https://api.example.com/api/v1
VITE_API_BASE_URL_NATIVE=https://api.example.com/api/v1
# Register these exact HTTPS callbacks in the backend/WeChat console. Native uses a Universal/App Link.
VITE_OAUTH_REDIRECT_URI_WEB=http://localhost:9000/official-accounts
VITE_OAUTH_REDIRECT_URI_ELECTRON=https://app.example.com/official-accounts
VITE_OAUTH_REDIRECT_URI_NATIVE=https://app.example.com/official-accounts
