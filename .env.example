# Environment
APP_ENV=development
APP_VERSION=0.1.0
APP_LOG_LEVEL=INFO
APP_PUBLIC_URL=http://localhost:9000
USER_WEB_URL=http://localhost:9000
ADMIN_WEB_URL=http://localhost:9000/admin/
API_PUBLIC_URL=http://localhost:9000/api

# PostgreSQL business database
BUSINESS_DB_NAME=wechat_ai
BUSINESS_DB_USER=wechat_ai
BUSINESS_DB_PASSWORD=change-this-development-password
DATABASE_URL=postgresql+asyncpg://wechat_ai:change-this-development-password@business-db:5432/wechat_ai

# PostgreSQL retrieval database
RETRIEVAL_DB_NAME=wechat_ai_retrieval
RETRIEVAL_DB_USER=wechat_ai
RETRIEVAL_DB_PASSWORD=change-this-development-password
RETRIEVAL_DATABASE_URL=postgresql+asyncpg://wechat_ai:change-this-development-password@retrieval-db:5432/wechat_ai_retrieval

# Redis and RabbitMQ
REDIS_URL=redis://redis:6379/0
RABBITMQ_USER=wechat_ai
RABBITMQ_PASSWORD=change-this-development-password
CELERY_BROKER_URL=amqp://wechat_ai:change-this-development-password@rabbitmq:5672/wechat_ai
CELERY_RESULT_BACKEND=redis://redis:6379/1

# S3-compatible object storage (development MinIO)
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=wechat_ai_dev
S3_SECRET_KEY=change-this-development-secret
S3_BUCKET_QUARANTINE=wechat-ai-quarantine
S3_BUCKET_PRIVATE=wechat-ai-private
S3_REGION=us-east-1

# Authentication. Generate unique values for every environment.
TOKEN_SECRET=replace-with-at-least-32-random-characters
MODEL_SECRET_MASTER_KEY=replace-with-a-different-32-character-random-secret
USER_COOKIE_NAME=ua_session
ADMIN_COOKIE_NAME=admin_session
CSRF_COOKIE_NAME=ua_csrf
ADMIN_CSRF_COOKIE_NAME=admin_csrf
ACCESS_TOKEN_TTL_SECONDS=604800
REFRESH_TOKEN_TTL_SECONDS=604800
ADMIN_ACCESS_TOKEN_TTL_SECONDS=600
ADMIN_SESSION_TTL_SECONDS=28800
COOKIE_SECURE=false
AUTO_CREATE_SCHEMA=false
DEFAULT_QUOTA_BALANCE=500
VERIFICATION_CODE_TTL_SECONDS=600
ALLOWED_ORIGINS=http://localhost:9000,http://127.0.0.1:9000,http://localhost:9003,http://127.0.0.1:9003,http://localhost:9004,http://127.0.0.1:9004,https://app.wechat-ai.local,https://localhost,capacitor://localhost

# External providers. Mock mode is safe for local development only.
MOCK_EXTERNAL_SERVICES=true
INLINE_MOCK_WORKERS=false
# Use "direct" after filling the six WECHAT_* values below. Keep "mock" only for local demos.
WECHAT_PROVIDER_MODE=direct
MODEL_PROVIDER_MODE=mock
EMBEDDING_PROVIDER_MODE=mock
RERANK_PROVIDER_MODE=mock
STORAGE_PROVIDER_MODE=mock
VERIFICATION_PROVIDER_MODE=mock
DOCUMENT_PROVIDER_MODE=mock
CONTENT_SAFETY_PROVIDER_MODE=mock
LAYOUT_PROVIDER_MODE=mock
LEXIANG_PROVIDER_MODE=disabled
SECRET_PROVIDER_MODE=env

# Real provider credentials are intentionally blank.
MODEL_API_BASE=
MODEL_API_STYLE=responses
MODEL_API_KEY_REF=env:MODEL_API_KEY
MODEL_NAME=
MODEL_API_KEY=
EMBEDDING_API_BASE=
EMBEDDING_API_KEY_REF=env:MODEL_API_KEY
EMBEDDING_MODEL=
EMBEDDING_DIMENSION=1024
RERANK_API_BASE=
RERANK_API_KEY_REF=env:RERANK_API_KEY
RERANK_MODEL=
CHUNK_TARGET_CHARACTERS=800
CHUNK_OVERLAP_CHARACTERS=120
CHUNKING_VERSION=zh-char-v1
CONTENT_SAFETY_API_BASE=https://api.openai.com/v1
CONTENT_SAFETY_API_KEY_REF=env:MODEL_API_KEY
CONTENT_SAFETY_MODEL=omni-moderation-latest
VERIFICATION_SERVICE_URL=
VERIFICATION_SECRET_REF=env:VERIFICATION_SERVICE_SECRET
OBJECT_STORAGE_ENDPOINT=http://minio:9000
OBJECT_STORAGE_BUCKET=wechat-ai-quarantine
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_ACCESS_KEY_REF=env:S3_ACCESS_KEY
OBJECT_STORAGE_SECRET_KEY_REF=env:S3_SECRET_KEY
DOCUMENT_SERVICE_URL=
DOCUMENT_SERVICE_SECRET_REF=env:DOCUMENT_SERVICE_SECRET
LAYOUT_SERVICE_URL=
LAYOUT_SERVICE_SECRET_REF=env:LAYOUT_SERVICE_SECRET
WECHAT_GATEWAY_URL=
WECHAT_GATEWAY_SECRET_REF=env:WECHAT_GATEWAY_SECRET
WECHAT_COMPONENT_APP_ID=
WECHAT_COMPONENT_APP_SECRET=
WECHAT_MESSAGE_TOKEN=
WECHAT_ENCODING_AES_KEY=
WECHAT_PUBLIC_BASE_URL=
WECHAT_AUTHORIZATION_CALLBACK_URL=
WECHAT_TICKET_CALLBACK_URL=
WECHAT_DOMAIN_VERIFICATION_FILENAME=
WECHAT_DOMAIN_VERIFICATION_CONTENT=
LEXIANG_APP_KEY=
LEXIANG_APP_SECRET=

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_SERVICE_NAME=wechat-ai-platform
SENTRY_DSN=
GRAFANA_ADMIN_PASSWORD=change-this-development-password
